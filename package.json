{
  "name": "openai-chatbot-server",
  "version": "1.0.0",
  "description": "Simple Node.js backend for a rule-based chatbot.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:full": "concurrently \"node server.js\" \"npm run start --prefix backend\"",
    "dev:full": "concurrently \"nodemon server.js\" \"npm run dev --prefix backend\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.5.0",
    "body-parser": "^1.20.2",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.10"
  },
  "type": "module"
}
